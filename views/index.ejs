<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pronto: {
                            primary: '#2563EB', // Blue 600
                            secondary: '#7C3AED', // Violet 600
                            accent: '#10B981', // Emerald 500
                            surface: '#FFFFFF',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 text-gray-900">
    <div class="min-h-screen flex flex-col">
        <!-- Header -->
        <header class="bg-white shadow-sm border-b border-gray-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center">
                    <a href="/" class="text-2xl font-bold text-pronto-primary tracking-tight">Pronto</a>
                </div>
                <nav class="flex space-x-4">
                    <a href="/dna" class="text-gray-600 hover:text-gray-900 font-medium px-3 py-2 rounded-md hover:bg-gray-50 transition-colors">Business DNA</a>
                    <a href="/campaign" class="text-gray-600 hover:text-gray-900 font-medium px-3 py-2 rounded-md hover:bg-gray-50 transition-colors">Campaigns</a>
                </nav>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-grow">
            <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
                <div class="px-4 text-center sm:px-0">
                    
                    <!-- Hero Section -->
                    <div class="bg-white overflow-hidden shadow-sm rounded-pronto mb-8 border border-gray-100">
                        <div class="px-4 py-16 sm:p-16">
                            <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mb-6 tracking-tight">
                                AI Marketing for <span class="text-pronto-primary">Bangladeshi SMBs</span>
                            </h1>
                            <p class="text-xl text-gray-500 mb-10 max-w-2xl mx-auto leading-relaxed">
                                Create professional, on-brand social media marketing assets in Bengali. Just enter your website, and let Pronto do the rest.
                            </p>
                            <div class="flex justify-center gap-4 flex-col sm:flex-row">
                                <a href="/dna" class="inline-flex justify-center items-center px-8 py-3.5 border border-transparent text-base font-semibold rounded-pronto shadow-lg shadow-pronto-primary/30 text-white bg-pronto-primary hover:bg-blue-700 transition-all hover:-translate-y-1">
                                    Setup Business DNA
                                </a>
                                <a href="/campaign" class="inline-flex justify-center items-center px-8 py-3.5 border border-gray-200 shadow-sm text-base font-medium rounded-pronto text-gray-700 bg-white hover:bg-gray-50 transition-all">
                                    Create Campaign
                                </a>
                            </div>
                        </div>
                    </div>
        
                    <!-- Stats Section -->
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        <div class="bg-white overflow-hidden shadow-sm rounded-pronto border border-gray-100 p-6 flex flex-col items-center hover:shadow-md transition-shadow">
                            <dt class="text-sm font-medium text-gray-500 uppercase tracking-wider">Active Campaigns</dt>
                            <dd class="mt-2 text-4xl font-extrabold text-pronto-secondary">3</dd>
                        </div>
                        <div class="bg-white overflow-hidden shadow-sm rounded-pronto border border-gray-100 p-6 flex flex-col items-center hover:shadow-md transition-shadow">
                            <dt class="text-sm font-medium text-gray-500 uppercase tracking-wider">Generated Assets</dt>
                            <dd class="mt-2 text-4xl font-extrabold text-pronto-accent">12</dd>
                        </div>
                        <div class="bg-white overflow-hidden shadow-sm rounded-pronto border border-gray-100 p-6 flex flex-col items-center hover:shadow-md transition-shadow">
                            <dt class="text-sm font-medium text-gray-500 uppercase tracking-wider">Time Saved</dt>
                            <dd class="mt-2 text-4xl font-extrabold text-pronto-primary">5h+</dd>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-gray-100 mt-auto">
            <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                <p class="text-center text-sm text-gray-500">
                    &copy; <%= new Date().getFullYear() %> Pronto. All rights reserved.
                </p>
            </div>
        </footer>
    </div>
</body>
</html>
