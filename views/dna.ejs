<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pronto: {
                            primary: '#2563EB',
                            secondary: '#7C3AED',
                            accent: '#10B981',
                            surface: '#FFFFFF',
                        }
                    }
                }
            }
        }
    </script>
</head>

<body
    class="font-sans antialiased text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
    <%- include('partials/background') %>
        <div class="min-h-screen flex flex-col relative z-10">
            <!-- Header -->
            <%- include('partials/header') %>

                <!-- Main Content -->
                <main class="flex-grow">
                    <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">

                        <div class="flex items-center justify-between mb-8">
                            <h2 className="text-3xl font-extrabold text-gray-900">Business DNA Setup</h2>
                            <span
                                class="bg-blue-100 dark:bg-blue-900/30 text-pronto-primary dark:text-blue-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
                                Step 1
                            </span>
                        </div>

                        <div
                            class="bg-white/60 dark:bg-gray-800/80 backdrop-blur-md rounded-xl shadow-lg p-8 mb-8 border border-white/50 dark:border-gray-700/50">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Website URL</label>
                            <form action="/dna/analyze" method="POST" class="flex gap-4">
                                <input type="url" name="website_url" required placeholder="https://your-business.com"
                                    class="flex-1 shadow-sm focus:ring-pronto-primary focus:border-pronto-primary block w-full sm:text-lg border-gray-300 dark:border-gray-600 rounded-xl p-3 border bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 transition-colors"
                                    value="<%= locals.url || '' %>" />
                                <button type="submit"
                                    class="inline-flex items-center px-6 py-3 border border-transparent text-base font-semibold rounded-pronto shadow-md text-white bg-pronto-primary hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-pronto-primary transition-all hover:-translate-y-0.5">
                                    Analyze Now
                                </button>
                            </form>
                            <% if (locals.error) { %>
                                <p class="mt-4 text-red-600 bg-red-50 p-3 rounded-pronto border border-red-100">
                                    <%= error %>
                                </p>
                                <% } %>
                        </div>

                        <% if (locals.dna) { %>
                            <div
                                class="bg-white/60 dark:bg-gray-800/80 backdrop-blur-md rounded-xl shadow-lg p-8 space-y-8 animate-fade-in border border-white/50 dark:border-gray-700/50">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                    <div>
                                        <label
                                            class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Business
                                            Name</label>
                                        <div class="text-xl font-bold text-gray-900 dark:text-white">
                                            <%= dna.business_name %>
                                        </div>
                                    </div>
                                    <div>
                                        <label
                                            class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Industry</label>
                                        <div class="text-xl font-medium text-gray-700 dark:text-gray-300">
                                            <%= dna.industry %>
                                        </div>
                                    </div>
                                </div>

                                <div class="border-t border-gray-100 pt-6">
                                    <label
                                        class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Brand
                                        Tone</label>
                                    <div class="flex gap-2 flex-wrap">
                                        <% dna.tone_tags?.forEach(function(tag) { %>
                                            <span
                                                class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-medium bg-purple-50 text-pronto-secondary border border-purple-100">
                                                <%= tag %>
                                            </span>
                                            <% }); %>
                                    </div>
                                </div>

                                <div class="border-t border-gray-100 pt-6">
                                    <label
                                        class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Detected
                                        Keywords (Bengali)</label>
                                    <div class="flex gap-2 flex-wrap">
                                        <% dna.keywords_bn?.forEach(function(k) { %>
                                            <span
                                                class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-medium bg-green-50 text-pronto-accent border border-green-100 font-sans">
                                                <%= k %>
                                            </span>
                                            <% }); %>
                                    </div>
                                </div>

                                <div class="border-t border-gray-100 pt-6">
                                    <label
                                        class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Primary
                                        Palette</label>
                                    <div class="flex gap-4">
                                        <% if (dna.primary_colors && dna.primary_colors.length> 0) { %>
                                            <% dna.primary_colors.forEach(function(color) { %>
                                                <div class="group relative">
                                                    <div class="w-16 h-16 rounded-xl border border-gray-200 shadow-sm"
                                                        style="background-color: <%= color %>;">
                                                    </div>
                                                    <span
                                                        class="absolute -bottom-6 left-0 text-xs text-gray-500 opacity-0 group-hover:opacity-100">
                                                        <%= color %>
                                                    </span>
                                                </div>
                                                <% }); %>
                                                    <% } else { %>
                                                        <p class="text-gray-400 text-sm">No colors detected</p>
                                                        <% } %>
                                    </div>
                                </div>

                                <div class="flex justify-end pt-6 border-t border-gray-100">
                                    <button id="save-dna-btn"
                                        class="bg-pronto-accent text-white px-8 py-3 rounded-pronto shadow-md hover:bg-green-600 font-semibold transition-all hover:-translate-y-0.5">
                                        Save DNA Profile
                                    </button>
                                </div>
                            </div>
                            <div id="dna-data-payload" data-json="<%= JSON.stringify(dna) %>" class="hidden"></div>
                            <script>
                                document.getElementById('save-dna-btn').addEventListener('click', async function () {
                                    const btn = this;
                                    const originalText = btn.innerText;
                                    // prettier-ignore
                                    const payload = document.getElementById('dna-data-payload').getAttribute('data-json');
                                    const dnaData = JSON.parse(payload);

                                    btn.disabled = true;
                                    btn.innerHTML = `
                                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg> Saving...`;

                                    try {
                                        const response = await fetch('/dna/save', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({
                                                user_id: 1,
                                                dna_data: dnaData
                                            })
                                        });

                                        const result = await response.json();

                                        if (result.success) {
                                            // Create success banner
                                            const successMsg = document.createElement('div');
                                            successMsg.className = "mb-4 p-4 bg-green-50 text-green-700 rounded-lg border border-green-200 font-semibold flex items-center";
                                            successMsg.innerHTML = `
                                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                        </svg>
                                        Business DNA Saved! You are ready for the next step.
                                    `;

                                            // Insert success message BEFORE the button's container (the parent of the button is a flex div)
                                            // But user wanted it slightly different. 
                                            // Let's insert it before the button inside the flex container, which makes it appear to the left of the button.
                                            btn.parentElement.insertBefore(successMsg, btn);

                                            // Update Button
                                            btn.innerHTML = `
                                        Continue to Campaigns 
                                        <svg class="w-4 h-4 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                        </svg>
                                    `;
                                            btn.className = "ml-auto bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-pronto shadow-md font-semibold transition-all hover:-translate-y-0.5";
                                            btn.disabled = false;

                                            // Replace button to remove old listeners
                                            const newBtn = btn.cloneNode(true);
                                            btn.replaceWith(newBtn);

                                            newBtn.onclick = function (e) {
                                                e.preventDefault();
                                                window.location.href = '/campaign';
                                            };
                                        } else {
                                            throw new Error(result.error);
                                        }
                                    } catch (error) {
                                        console.error('Save error:', error);
                                        alert('Failed to save profile: ' + error.message);
                                        btn.disabled = false;
                                        btn.innerText = originalText;
                                    }
                                });
                            </script>
                            <% } %>

                    </div>
                </main>

                <!-- Footer -->
                <footer class="bg-white border-t border-gray-100 mt-auto">
                    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                        <p class="text-center text-sm text-gray-500">
                            &copy; <%= new Date().getFullYear() %> Pronto. All rights reserved.
                        </p>
                    </div>
                </footer>
        </div>
</body>

</html>