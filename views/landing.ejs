<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pronto | Design at the Speed of Thought</title>
    <script src="/js/theme.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.1.0/fonts/remixicon.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            overflow-x: hidden;
        }

        /* Animations */

        @keyframes gradient-x {

            0%,
            100% {
                background-size: 200% 200%;
                background-position: left center;
            }

            50% {
                background-size: 200% 200%;
                background-position: right center;
            }
        }

        .animate-gradient-x {
            animation: gradient-x 6s ease infinite;
        }

        .tilt-card {
            transition: transform 0.1s ease;
        }

        .tilt-card:hover {
            transform: perspective(1000px) rotateX(2deg) rotateY(2deg) scale(1.02);
            z-index: 10;
        }
    </style>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        pronto: {
                            primary: '#2563EB',
                        }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-gray-50 dark:bg-gray-950 relative min-h-screen transition-colors duration-300">

    <%- include('partials/background') %>

        <!-- Header -->
        <%- include('partials/header') %>

            <!-- Main Content -->
            <main class="relative pt-16 pb-16 px-4">

                <!-- Hero -->
                <div class="text-center max-w-4xl mx-auto mb-16">
                    <h1
                        class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 leading-tight text-gray-900 dark:text-white">
                        Design at the <br>
                        <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 via-pink-600 to-blue-600 animate-gradient-x">Speed
                            of Thought.</span>
                    </h1>
                    <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 mb-10 max-w-2xl mx-auto font-light">
                        The AI Studio that knows your Brand DNA. Generate on-brand campaigns in seconds, not days.
                    </p>
                    <a href="/campaign"
                        class="inline-flex items-center px-8 py-4 bg-gray-900 dark:bg-white text-white dark:text-black text-lg font-medium rounded-full shadow-2xl hover:scale-105 transition-transform duration-300 hover:bg-black dark:hover:bg-gray-200">
                        Start Creating Free
                        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 7l5 5m0 0l-5 5m5-5H6">
                            </path>
                        </svg>
                    </a>
                </div>

                <!-- Bento Grid -->
                <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-6">

                    <!-- Card 1: Brand DNA (Large) -->
                    <div
                        class="tilt-card md:col-span-2 bg-white/40 dark:bg-black/40 backdrop-blur-md border border-white/50 dark:border-white/10 rounded-[2rem] p-8 shadow-xl hover:shadow-2xl hover:bg-white/60 dark:hover:bg-black/60 transition duration-500 flex flex-col justify-between overflow-hidden relative group">
                        <div
                            class="absolute -right-10 -top-10 w-40 h-40 bg-gradient-to-br from-blue-400 to-cyan-300 dark:from-blue-600 dark:to-cyan-500 rounded-full blur-2xl opacity-50 group-hover:scale-150 transition duration-700">
                        </div>
                        <div>
                            <div
                                class="w-12 h-12 bg-white dark:bg-gray-800 rounded-2xl flex items-center justify-center mb-4 shadow-sm">
                                <i class="ri-flask-line text-2xl text-blue-600"></i>
                            </div>
                            <h3 class="text-2xl font-bold text-gray-800 dark:text-white mb-2">Smart Brand DNA</h3>
                            <p class="text-gray-600 dark:text-gray-400">We extract your colors and voice instantly. Your
                                brand,
                                preserved
                                perfectly.</p>
                        </div>
                        <div class="mt-8 flex gap-4">
                            <div class="h-16 w-16 rounded-2xl bg-indigo-600 shadow-lg transform -rotate-6"></div>
                            <div class="h-16 w-16 rounded-2xl bg-purple-500 shadow-lg transform rotate-3 z-10"></div>
                            <div class="h-16 w-16 rounded-2xl bg-pink-500 shadow-lg transform -rotate-3"></div>
                        </div>
                    </div>

                    <!-- Card 2: AI Copywriter -->
                    <div
                        class="tilt-card md:col-span-1 bg-white/40 dark:bg-black/40 backdrop-blur-md border border-white/50 dark:border-white/10 rounded-[2rem] p-8 shadow-xl hover:shadow-2xl hover:bg-white/60 dark:hover:bg-black/60 transition duration-500 relative overflow-hidden group">
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-white/80 dark:from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition duration-500">
                        </div>
                        <div
                            class="w-12 h-12 bg-white dark:bg-gray-800 rounded-2xl flex items-center justify-center mb-4 shadow-sm relative z-10">
                            <i class="ri-quill-pen-line text-2xl text-purple-600"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-2 relative z-10">AI Copywriter
                        </h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400 relative z-10">It speaks your language,
                            fluent in
                            your brand's unique
                            tone.</p>
                    </div>

                    <!-- Card 3: Visuals -->
                    <div
                        class="tilt-card md:col-span-1 bg-white/40 dark:bg-black/40 backdrop-blur-md border border-white/50 dark:border-white/10 rounded-[2rem] p-8 shadow-xl hover:shadow-2xl hover:bg-white/60 dark:hover:bg-black/60 transition duration-500 relative overflow-hidden">
                        <div class="absolute inset-0">
                            <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80"
                                class="w-full h-full object-cover opacity-80 hover:scale-110 transition duration-700">
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-white/90 dark:from-black/90 via-transparent to-transparent">
                            </div>
                        </div>
                        <div class="relative z-10 mt-24">
                            <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-1">Retail Ready</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Stunning product visuals.</p>
                        </div>
                    </div>

                    <!-- Card 4: Magic Resize (Wide) -->
                    <div
                        class="tilt-card md:col-span-4 bg-white/40 dark:bg-black/40 backdrop-blur-md border border-white/50 dark:border-white/10 rounded-[2rem] p-8 md:p-12 shadow-xl hover:shadow-2xl hover:bg-white/60 dark:hover:bg-black/60 transition duration-500 flex flex-col md:flex-row items-center justify-between overflow-hidden relative">
                        <div class="relative z-10 max-w-lg">
                            <div
                                class="inline-flex items-center px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-xs font-bold uppercase tracking-wide mb-4">
                                New Feature</div>
                            <h3 class="text-3xl font-bold text-gray-800 dark:text-white mb-4">Magic Resize</h3>
                            <p class="text-lg text-gray-600 dark:text-gray-400">One click. Every Platform. Instantly
                                adapt
                                your
                                content for
                                Instagram, Facebook, and more.</p>
                        </div>
                        <div class="flex gap-6 mt-8 md:mt-0 relative z-10 opacity-80">
                            <div
                                class="w-20 h-32 border-4 border-gray-800/20 dark:border-white/20 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
                                <i class="ri-smartphone-line text-2xl text-gray-600 dark:text-gray-300"></i>
                            </div>
                            <div
                                class="w-32 h-24 border-4 border-gray-800/20 dark:border-white/20 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
                                <i class="ri-macbook-line text-2xl text-gray-600 dark:text-gray-300"></i>
                            </div>
                            <div
                                class="w-24 h-32 border-4 border-gray-800/20 dark:border-white/20 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
                                <i class="ri-tablet-line text-2xl text-gray-600 dark:text-gray-300"></i>
                            </div>
                        </div>
                    </div>

                </div>

            </main>

            <footer class="text-center py-10 text-gray-400 dark:text-gray-500 text-sm font-medium">
                Crafted by Pronto.
            </footer>

            <script>
                // Simple tilt effect script
                document.querySelectorAll('.tilt-card').forEach(card => {
                    card.addEventListener('mousemove', (e) => {
                        const rect = card.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        const centerX = rect.width / 2;
                        const centerY = rect.height / 2;

                        const rotateX = ((y - centerY) / centerY) * -2; // max rotation deg
                        const rotateY = ((x - centerX) / centerX) * 2;

                        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
                    });

                    card.addEventListener('mouseleave', () => {
                        card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale(1)';
                    });
                });
            </script>
</body>

</html>